{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["ES2019"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/utils/**/*.ts", "src/sync/conflictResolution.ts", "src/types/**/*.ts", "src/__tests__/**/*.ts"]
}
